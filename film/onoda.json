 "lines": [
  {
   "i": 0,
   "start": 0.3,
   "end": 5.787,
   "text": "This soldier kept fighting World War II for 29 years after it ended."
  },
  {
   "i": 1,
   "start": 5.967,
   "end": 12.941,
   "text": "Hiroo Onoda was a Japanese soldier sent to a Philippine island in 1944."
  },
  {
   "i": 2,
   "start": 13.121,
   "end": 15.83,
   "text": "His orders were simple: never surrender."
  },
  {
   "i": 3,
   "start": 16.01,
   "end": 21.264,
   "text": "In 1945, the war ended. But Onoda never got the message."
  },
  {
   "i": 4,
   "start": 21.444,
   "end": 26.009,
   "text": "Planes dropped leaflets saying the war was over. He thought it was an enemy trick."
  },
  {
   "i": 5,
   "start": 26.189,
   "end": 29.201,
   "text": "His friends gave up or died, until he was alone."
  },
  {
   "i": 6,
   "start": 29.381,
   "end": 34.089,
   "text": "He lived in the jungle for decades, surviving on coconuts and bananas."
  },
  {
   "i": 7,
   "start": 34.269,
   "end": 41.612,
   "text": "In 1974, a young traveler named Norio Suzuki found him. Onoda still refused to leave."
  },
  {
   "i": 8,
   "start": 41.792,
   "end": 45.245,
   "text": "He said he would only stop if his own commander ordered it."
  },
  {
   "i": 9,
   "start": 45.425,
   "end": 50.528,
   "text": "So Japan found his old commander, now a bookseller, and flew him to the island."
  },
  {
   "i": 10,
   "start": 50.708,
   "end": 55.4,
   "text": "He finally gave the order, and Onoda surrendered after 29 years."
  },
  {
   "i": 11,
   "start": 55.58,
   "end": 58.977,
   "text": "He wasn't hiding from the war. He was just still loyal to it."
  }
 ],
